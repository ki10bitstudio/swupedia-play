# Copy this file to .env.local and customize for your development environment
# This file won't be committed to git (see .gitignore)

# Override ROOT_URL with your local IP address for mobile testing
# Example: NEXT_PUBLIC_ROOT_URL=http://192.168.4.40:9500
NEXT_PUBLIC_ROOT_URL=http://your-local-ip:9500

# Other custom settings

# Set to true to display the BreakpointOverlay for responsive design debugging
# NEXT_PUBLIC_SHOW_BREAKPOINT_OVERLAY=true

# Set to true to display debug borders
# NEXT_PUBLIC_DEBUG_BORDERS=true

# Set to true to display detailed hand scaling debug info
# NEXT_PUBLIC_DEBUG_HAND_SCALING=true

# swupedia.com origin for links back to the site (only the Credits link uses it in development)
# NEXT_PUBLIC_SWUPEDIA_URL=https://swupedia.com
